+	cache_key="$(printf '%s' "v1|${group}|${value}|guard=${ss_basic_dns_guard_mode:-0}|$(smartdns_should_seed_isp_defaults)|$(smartdns_get_isp_dns_slot 1)|$(smartdns_get_isp_dns_slot 2)" | md5sum | awk '{print $1}')"
