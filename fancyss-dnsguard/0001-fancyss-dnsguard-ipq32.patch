diff --git a/tests/test_dns_guard.sh b/tests/test_dns_guard.sh
new file mode 100755
index 0000000..133b574
--- /dev/null
+++ b/tests/test_dns_guard.sh
@@ -0,0 +1,108 @@
+#!/bin/sh
+
+set -eu
+
+ROOT_DIR=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
+TMP_DIR=$(mktemp -d "${TMPDIR:-/tmp}/fancyss-dnsguard-test.XXXXXX")
+
+cleanup() {
+	rm -rf "${TMP_DIR}"
+}
+trap cleanup EXIT INT TERM
+
+run() {
+	"$@"
+}
+
+echo_date() {
+	:
+}
+
+proxy_core_supports_udp() {
+	return 0
+}
+
+# ss_base_dns.sh contains function definitions and constants only, so it is safe
+# to load in this isolated test shell.
+. "${ROOT_DIR}/fancyss/scripts/ss_base_dns.sh"
+
+ss_basic_dns_guard_mode=1
+
+chn_json=$(smartdns_group_json chn)
+gfw_json=$(smartdns_group_json gfw)
+
+printf '%s' "${chn_json}" | jq -e '
+	(.items | length) == 2 and
+	all(.items[]; .proto == "dot" and .port == 853 and (.host_ip | length) > 0)
+' >/dev/null
+
+printf '%s' "${gfw_json}" | jq -e '
+	(.items | length) == 2 and
+	all(.items[]; .proto == "dot" and .port == 853 and (.host_ip | length) > 0)
+' >/dev/null
+
+grep -q 'ss_basic_dns_guard_mode' "${ROOT_DIR}/fancyss/webs/Module_shadowsocks.asp"
+grep -q 'dns_guard_filter_control' "${ROOT_DIR}/fancyss/ss/ssconfig.sh"
+grep -q 'line="server-tls \${host}"' "${ROOT_DIR}/fancyss/ss/ssconfig.sh"
+grep -q 'line="\${line} -host-ip \${host_ip}"' "${ROOT_DIR}/fancyss/ss/ssconfig.sh"
+
+FW_LOG="${TMP_DIR}/firewall.log"
+: > "${FW_LOG}"
+
+iptables() {
+	printf 'iptables %s\n' "$*" >> "${FW_LOG}"
+	case " $* " in
+	*' -C '*) return 1 ;;
+	*) return 0 ;;
+	esac
+}
+
+ip6tables() {
+	printf 'ip6tables %s\n' "$*" >> "${FW_LOG}"
+	case " $* " in
+	*' -C '*) return 1 ;;
+	*) return 0 ;;
+	esac
+}
+
+ensure_chain() {
+	printf 'ensure_chain %s\n' "$*" >> "${FW_LOG}"
+}
+
+ensure_chain6() {
+	printf 'ensure_chain6 %s\n' "$*" >> "${FW_LOG}"
+}
+
+append_if_not_exists() {
+	printf 'append4 %s\n' "$*" >> "${FW_LOG}"
+}
+
+append_if_not_exists6() {
+	printf 'append6 %s\n' "$*" >> "${FW_LOG}"
+}
+
+eval "$(sed -n '/^dns_guard_filter_control() {/,/^flush_iptables() {/p' "${ROOT_DIR}/fancyss/ss/ssconfig.sh" | sed '$d')"
+
+ss_basic_dns_guard_mode=1
+dns_guard_filter_control
+grep -q 'iptables -t filter -I FORWARD 1 -j SHADOWSOCKS_DNS_GUARD' "${FW_LOG}"
+grep -q 'ip6tables -t filter -I FORWARD 1 -j SHADOWSOCKS6_DNS_GUARD' "${FW_LOG}"
+if grep -q 'DNS_GUARD_OUT' "${FW_LOG}"; then
+	echo "Standard mode unexpectedly installed strict OUTPUT rules" >&2
+	exit 1
+fi
+
+: > "${FW_LOG}"
+ss_basic_dns_guard_mode=2
+dns_guard_filter_control
+grep -q 'iptables -t filter -I OUTPUT 1 -j SHADOWSOCKS_DNS_GUARD_OUT' "${FW_LOG}"
+grep -q 'ip6tables -t filter -I OUTPUT 1 -j SHADOWSOCKS6_DNS_GUARD_OUT' "${FW_LOG}"
+
+return_line=$(grep -n 'append4 filter -A SHADOWSOCKS_DNS_GUARD_OUT -d 127.0.0.0/8 -j RETURN' "${FW_LOG}" | cut -d: -f1)
+reject_line=$(grep -n 'append4 filter -A SHADOWSOCKS_DNS_GUARD_OUT -p udp --dport 53 -j REJECT' "${FW_LOG}" | cut -d: -f1)
+if [ "${return_line}" -ge "${reject_line}" ]; then
+	echo "Strict mode loopback exception is ordered after its reject rule" >&2
+	exit 1
+fi
+
+echo "DNS Guard tests passed"
-- 
