+dns_guard_filter_control() {
+	case "${ss_basic_dns_guard_mode}" in
+	1|2)
+		;;
+	*)
+		return 0
+		;;
+	esac
+
+	echo_date "DNS Guard：阻止局域网通过IPv4/IPv6明文DNS外泄..."
+	ensure_chain filter SHADOWSOCKS_DNS_GUARD || return 1
+	append_if_not_exists filter -A SHADOWSOCKS_DNS_GUARD -p udp --dport 53 -j REJECT --reject-with icmp-port-unreachable || return 1
+	append_if_not_exists filter -A SHADOWSOCKS_DNS_GUARD -p tcp --dport 53 -j REJECT --reject-with tcp-reset || return 1
+	if ! iptables -t filter -C FORWARD -j SHADOWSOCKS_DNS_GUARD >/dev/null 2>&1;then
+		iptables -t filter -I FORWARD 1 -j SHADOWSOCKS_DNS_GUARD >/dev/null 2>&1 || return 1
+	fi
+
+	if ip6tables -t filter -L FORWARD >/dev/null 2>&1;then
+		ensure_chain6 filter SHADOWSOCKS6_DNS_GUARD || return 1
+		append_if_not_exists6 filter -A SHADOWSOCKS6_DNS_GUARD -p udp --dport 53 -j REJECT --reject-with icmp6-port-unreachable || return 1
+		append_if_not_exists6 filter -A SHADOWSOCKS6_DNS_GUARD -p tcp --dport 53 -j REJECT --reject-with tcp-reset || return 1
+		if ! ip6tables -t filter -C FORWARD -j SHADOWSOCKS6_DNS_GUARD >/dev/null 2>&1;then
+			ip6tables -t filter -I FORWARD 1 -j SHADOWSOCKS6_DNS_GUARD >/dev/null 2>&1 || return 1
+		fi
+	else
+		echo_date "DNS Guard：当前固件不可用ip6tables filter，已跳过IPv6明文DNS阻断。"
+	fi
+
+	if [ "${ss_basic_dns_guard_mode}" = "2" ];then
+		echo_date "DNS Guard严格模式：阻止路由器自身发出明文DNS..."
+		ensure_chain filter SHADOWSOCKS_DNS_GUARD_OUT || return 1
+		append_if_not_exists filter -A SHADOWSOCKS_DNS_GUARD_OUT -d 127.0.0.0/8 -j RETURN || return 1
+		append_if_not_exists filter -A SHADOWSOCKS_DNS_GUARD_OUT -p udp --dport 53 -j REJECT --reject-with icmp-port-unreachable || return 1
+		append_if_not_exists filter -A SHADOWSOCKS_DNS_GUARD_OUT -p tcp --dport 53 -j REJECT --reject-with tcp-reset || return 1
+		if ! iptables -t filter -C OUTPUT -j SHADOWSOCKS_DNS_GUARD_OUT >/dev/null 2>&1;then
+			iptables -t filter -I OUTPUT 1 -j SHADOWSOCKS_DNS_GUARD_OUT >/dev/null 2>&1 || return 1
+		fi
+		if ip6tables -t filter -L SHADOWSOCKS6_DNS_GUARD >/dev/null 2>&1;then
+			ensure_chain6 filter SHADOWSOCKS6_DNS_GUARD_OUT || return 1
+			append_if_not_exists6 filter -A SHADOWSOCKS6_DNS_GUARD_OUT -d ::1/128 -j RETURN || return 1
+			append_if_not_exists6 filter -A SHADOWSOCKS6_DNS_GUARD_OUT -p udp --dport 53 -j REJECT --reject-with icmp6-port-unreachable || return 1
+			append_if_not_exists6 filter -A SHADOWSOCKS6_DNS_GUARD_OUT -p tcp --dport 53 -j REJECT --reject-with tcp-reset || return 1
+			if ! ip6tables -t filter -C OUTPUT -j SHADOWSOCKS6_DNS_GUARD_OUT >/dev/null 2>&1;then
+				ip6tables -t filter -I OUTPUT 1 -j SHADOWSOCKS6_DNS_GUARD_OUT >/dev/null 2>&1 || return 1
+			fi
+		fi
+	fi
+}
