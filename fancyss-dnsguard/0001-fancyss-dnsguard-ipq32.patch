--- /dev/null
+++ b/build_dns_guard_ipq32.sh
@@ -0,0 +1,76 @@
+#!/usr/bin/env bash
+
+set -euo pipefail
+
+ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+BASE_PACKAGE="${1:-${ROOT_DIR}/packages/fancyss_ipq32_full.tar.gz}"
+OUTPUT_PACKAGE="${2:-${ROOT_DIR}/packages/fancyss_ipq32_full_dnsguard.tar.gz}"
+STAGE_DIR="$(mktemp -d "${TMPDIR:-/tmp}/fancyss-dnsguard-ipq32.XXXXXX")"
+
+cleanup() {
+	rm -rf "${STAGE_DIR}"
+}
+trap cleanup EXIT INT TERM
+
+require_file() {
+	if [[ ! -f "$1" ]]; then
+		echo "Missing required file: $1" >&2
+		exit 1
+	fi
+}
+
+require_file "${BASE_PACKAGE}"
+require_file "${ROOT_DIR}/fancyss/scripts/ss_base_dns.sh"
+require_file "${ROOT_DIR}/fancyss/ss/ssconfig.sh"
+require_file "${ROOT_DIR}/fancyss/webs/Module_shadowsocks.asp"
+
+if ! tar -tzf "${BASE_PACKAGE}" | grep -qx 'shadowsocks/install.sh'; then
+	echo "The base archive is not a fancyss offline package: ${BASE_PACKAGE}" >&2
+	exit 1
+fi
+
+tar -xzf "${BASE_PACKAGE}" -C "${STAGE_DIR}"
+install -m 0755 "${ROOT_DIR}/fancyss/scripts/ss_base_dns.sh" "${STAGE_DIR}/shadowsocks/scripts/ss_base_dns.sh"
+install -m 0755 "${ROOT_DIR}/fancyss/ss/ssconfig.sh" "${STAGE_DIR}/shadowsocks/ss/ssconfig.sh"
+install -m 0644 "${ROOT_DIR}/fancyss/webs/Module_shadowsocks.asp" "${STAGE_DIR}/shadowsocks/webs/Module_shadowsocks.asp"
+install -m 0644 "${ROOT_DIR}/DNS_GUARD_IPQ32.md" "${STAGE_DIR}/shadowsocks/ss/DNS_GUARD_IPQ32.md"
+
+mkdir -p "$(dirname "${OUTPUT_PACKAGE}")"
+rm -f "${OUTPUT_PACKAGE}" "${OUTPUT_PACKAGE}.sha256" "${OUTPUT_PACKAGE}.md5"
+COPYFILE_DISABLE=1 tar -czf "${OUTPUT_PACKAGE}" -C "${STAGE_DIR}" shadowsocks
+
+if tar -tzf "${OUTPUT_PACKAGE}" | grep -Eq '(^|/)\._|__MACOSX'; then
+	echo "AppleDouble metadata was found in the output archive" >&2
+	exit 1
+fi
+
+for required_path in \
+	shadowsocks/install.sh \
+	shadowsocks/bin/smartdns \
+	shadowsocks/bin/xray \
+	shadowsocks/scripts/ss_base_dns.sh \
+	shadowsocks/ss/ssconfig.sh \
+	shadowsocks/webs/Module_shadowsocks.asp \
+	shadowsocks/ss/DNS_GUARD_IPQ32.md
+do
+	if ! tar -tzf "${OUTPUT_PACKAGE}" | grep -qx "${required_path}"; then
+		echo "Output archive is missing ${required_path}" >&2
+		exit 1
+	fi
+done
+
+if command -v sha256sum >/dev/null 2>&1; then
+	sha256sum "${OUTPUT_PACKAGE}" > "${OUTPUT_PACKAGE}.sha256"
+else
+	shasum -a 256 "${OUTPUT_PACKAGE}" > "${OUTPUT_PACKAGE}.sha256"
+fi
+
+if command -v md5sum >/dev/null 2>&1; then
+	md5sum "${OUTPUT_PACKAGE}" > "${OUTPUT_PACKAGE}.md5"
+else
+	md5 -r "${OUTPUT_PACKAGE}" > "${OUTPUT_PACKAGE}.md5"
+fi
+
+echo "Built: ${OUTPUT_PACKAGE}"
+echo "SHA-256: $(awk '{print $1}' "${OUTPUT_PACKAGE}.sha256")"
+
