+			      proto: "dot",
+			      provider: "DNSPod",
+			      description: "DNS Guard encrypted backup",
+			      kind: "preset",
+			      host: "dot.pub",
+			      host_ip: "1.12.12.21",
+			      port: 853,
+			      isp: 0,
+			      net: "ipv4"
+			    }
